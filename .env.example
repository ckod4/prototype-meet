###############################################################################
# Prototype Meet - configuration unique
# Copier en .env : ./scripts/init-env.sh
# Les valeurs marquées __GENERATE__ sont remplacées par des secrets aléatoires.
###############################################################################

# --- Application -------------------------------------------------------------
APP_BASE_URL=http://localhost:3080
PORT=3080
MASTER_API_KEY=__GENERATE__
BRAND_NAME=Visio Créneau
BRAND_COLOR=#e11d48
BRAND_LOGO_URL=
BRAND_FOOTER=Service de visioconférence à créneau strict
DISPLAY_TIMEZONE=Europe/Paris

# --- Limites -----------------------------------------------------------------
MAX_PARTICIPANTS=30
MAX_CONCURRENT_MEETINGS=10
MIN_MEETING_MINUTES=30
MAX_MEETING_MINUTES=480
MAX_EARLY_JOIN_MINUTES=60
END_WARNING_MINUTES=3
TRANSCRIPTION_GRACE_SECONDS=120

# --- Stockage objet S3 (RustFS en local, compatible S3) ----------------------
S3_ENDPOINT=http://rustfs:9000
S3_PUBLIC_ENDPOINT=http://localhost:9002
S3_REGION=us-east-1
S3_BUCKET=prototype-meet
S3_ACCESS_KEY=__GENERATE__
S3_SECRET_KEY=__GENERATE__
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_TTL_SECONDS=900

# --- Webhooks sortants -------------------------------------------------------
# Receveur d'exemple : node scripts/webhook-receiver.js
WEBHOOK_URL=
WEBHOOK_SECRET=__GENERATE__

# --- Chemins internes aux conteneurs ----------------------------------------
DB_PATH=/data/app.db
CAPTURES_DIR=/captures
RECORDINGS_DIR=/recordings

# --- Transcription auto-hébergée (worker Python) -----------------------------
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=fr

# --- Jitsi Meet --------------------------------------------------------------
JITSI_IMAGE_VERSION=unstable
CONFIG=./data/jitsi
HTTP_PORT=9080
HTTPS_PORT=9443
PUBLIC_URL=https://meet.localhost:9443
JITSI_PUBLIC_HOST=meet.localhost
JITSI_PUBLIC_URL=https://meet.localhost:9443
TZ=Europe/Paris
RESTART_POLICY=unless-stopped

JVB_PORT=10001
JICOFO_REST_PORT=8889
JVB_COLIBRI_PORT=8081

ENABLE_AUTH=1
AUTH_TYPE=jwt
JWT_APP_ID=prototype-meet
JWT_APP_SECRET=__GENERATE__
JWT_ACCEPTED_ISSUERS=prototype-meet
JWT_ACCEPTED_AUDIENCES=jitsi
JWT_ALLOW_EMPTY=0
JWT_ENABLE_DOMAIN_VERIFICATION=0

ENABLE_GUESTS=0
ENABLE_RECORDING=1
ENABLE_TRANSCRIPTIONS=0
ENABLE_XMPP_WEBSOCKET=1
ENABLE_PREJOIN_PAGE=0
ENABLE_REQUIRE_DISPLAY_NAME=1
HIDE_PREJOIN_DISPLAY_NAME=1
DISABLE_PROFILE=1
DISABLE_DEEP_LINKING=1
DISABLE_GRANT_MODERATOR=1
DISABLE_PRIVATE_CHAT=1
DISABLE_LOCAL_RECORDING=1
ENABLE_END_CONFERENCE=1
DEFAULT_LANGUAGE=fr
PREFERRED_LANGUAGE=fr
ENABLE_WELCOME_PAGE=0
ENABLE_LETSENCRYPT=0

# Secrets internes XMPP
JICOFO_AUTH_PASSWORD=__GENERATE__
JVB_AUTH_PASSWORD=__GENERATE__
JIGASI_XMPP_PASSWORD=__GENERATE__
JIGASI_TRANSCRIBER_PASSWORD=__GENERATE__
JIBRI_RECORDER_PASSWORD=__GENERATE__
JIBRI_XMPP_PASSWORD=__GENERATE__

# Jibri
JIBRI_XMPP_USER=jibri
JIBRI_RECORDER_USER=recorder
JIBRI_BREWERY_MUC=jibribrewery
JIBRI_RECORDING_DIR=/config/recordings
JIBRI_STRIP_DOMAIN_JID=muc
JIBRI_PENDING_TIMEOUT=90
JIBRI_USAGE_TIMEOUT=0
JIBRI_RECORDING_RESOLUTION=1280x720
JIBRI_RECORDING_FRAMERATE=30
IGNORE_CERTIFICATE_ERRORS=1


# --- Interface web -----------------------------------------------------------
WEB_PORT=3090
WEB_CLIENT_ID=web
WEB_BASE_URL=http://localhost:3090
API_INTERNAL_URL=http://api:3080
WEB_DB_PATH=/data/web.db
WEB_SESSION_SECRET=__GENERATE__
WEB_ENCRYPTION_KEY=__GENERATE__

# --- Pilotage automatique de Jibri ---
JIBRI_HTTP_API_URL=http://jibri:2222
JIBRI_CALL_LOGIN_DOMAIN=hidden.meet.jitsi
MAX_CONCURRENT_RECORDINGS=1
